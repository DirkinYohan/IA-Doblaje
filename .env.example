# =============================================================================
# IA-DOBLAJE ENGINE - ENVIRONMENT VARIABLES (Fase 1)
# =============================================================================
# Copie este archivo a .env y ajuste los valores.
# NUNCA commitee el archivo .env con secretos reales.
# =============================================================================

# -----------------------------------------------------------------------------
# GENERAL / APP
# -----------------------------------------------------------------------------
APP_NAME="IA Doblaje Engine"
APP_ENV="development"              # development | staging | production
APP_DEBUG=true
APP_LOG_LEVEL="INFO"               # DEBUG | INFO | WARNING | ERROR | CRITICAL
APP_LOG_FORMAT="human"             # human | json
APP_JOB_ID_PREFIX="job"

# -----------------------------------------------------------------------------
# PATHS
# -----------------------------------------------------------------------------
DATA_INPUT_DIR="data/input"
DATA_OUTPUT_DIR="data/output"
DATA_TEMP_DIR="data/temporary"
MODELS_CACHE_DIR="models"
CONFIGS_DIR="configs"

# -----------------------------------------------------------------------------
# SECURITY / SAFETY
# -----------------------------------------------------------------------------
MAX_MEDIA_SIZE_GB=10.0
ALLOWED_EXTENSIONS="mp4,mkv,mov,wav,mp3,m4a"
REQUIRE_PATH_WITHIN_DATA_DIR=true
ENABLE_AUTO_TEMP_CLEANUP=true

# -----------------------------------------------------------------------------
# PROCESSING PROFILE (PUNTO 6: quality | balanced | performance)
# -----------------------------------------------------------------------------
PROFILE="balanced"                 # quality | balanced | performance
DEVICE="auto"                      # auto | cuda | cpu | mps
FORCE_CPU=false

# -----------------------------------------------------------------------------
# DEVICE / GPU
# -----------------------------------------------------------------------------
CUDA_VISIBLE_DEVICES=""            # "" = todos los GPUs disponibles
ALLOW_MPS=true                     # Apple Silicon
DETECT_DEVICE_VERBOSE=true
VRAM_HEADROOM_MB=800               # Reservar memoria VRAM para no OOM
GPU_AUTO_DOWNGRADE_ENABLED=false   # PUNTO 2: false = NO downgrade silencioso

# -----------------------------------------------------------------------------
# AUDIO EXTRACTION (FFmpeg)
# -----------------------------------------------------------------------------
FFMPEG_BIN="ffmpeg"                # Path absoluto o nombre binario en PATH
FFPROBE_BIN="ffprobe"
FFMPEG_TIMEOUT_SEC=7200            # 2h máximo películas largas
FFMPEG_BUILD_CONF_LABEL="LGPL"     # Documentar build usado

TARGET_SAMPLE_RATE_HZ=16000
TARGET_CHANNELS=1                  # mono
TARGET_BIT_DEPTH=16                # PCM 16-bit
TARGET_FORMAT="wav"

# -----------------------------------------------------------------------------
# VAD
# -----------------------------------------------------------------------------
VAD_ADAPTER="silero"               # silero | mock | disabled
VAD_MODEL_VERSION="v5.1"
VAD_SPEECH_THRESHOLD=0.5
VAD_MIN_SILENCE_DURATION_MS=300
VAD_MIN_SPEECH_DURATION_MS=250
VAD_SPEECH_PAD_MS=50

# -----------------------------------------------------------------------------
# ASR (SPEECH-TO-TEXT)
# -----------------------------------------------------------------------------
ASR_ADAPTER_AUTO=true              # Selecciona adapter por profile
ASR_ADAPTER_OVERRIDE=""            # faster-whisper | whisper-pytorch | ""=auto

ASR_WHISPER_MODEL_NAME="large-v3"  # tiny | base | small | medium | large-v3
ASR_WHISPER_BEAM_SIZE=3
ASR_WHISPER_TEMPERATURE=0.0
ASR_COMPUTE_TYPE="auto"            # auto | float16 | int8_float16 | int8 | int8_bfloat16
ASR_BATCH_SIZE=0                   # 0 = auto
ASR_WORD_TIMESTAMPS=true
ASR_CONFIDENCE_THRESHOLD=0.0

# Profile overrides (configuración PUNTO 6 - también se puede en YAML configs/)
# PROFILE=PERFORMANCE -> faster-whisper large-v3 int8_float16 beam=1
# PROFILE=BALANCED    -> whisper-pytorch medium beam=3
# PROFILE=QUALITY     -> whisper-pytorch large-v3 beam=5

# -----------------------------------------------------------------------------
# LANGUAGE DETECTION
# -----------------------------------------------------------------------------
LANG_DETECT_ADAPTER="whisper-encoder"
LANG_MIN_CONFIDENCE=0.40           # Aborta si conf < umbral
LANG_FORCE_CODE=""                 # "es", "en", ""=auto detect

# -----------------------------------------------------------------------------
# SPEAKER DIARIZATION
# -----------------------------------------------------------------------------
DIARIZATION_ADAPTER="pyannote"     # pyannote | speechbrain | mock | disabled
DIARIZATION_MODEL_NAME="pyannote/speaker-diarization-3.1"
DIARIZATION_SEGMENTATION_MODEL="pyannote/segmentation-3.0"
DIARIZATION_MIN_SPEAKERS=1
DIARIZATION_MAX_SPEAKERS=20        # Límite razonable películas
DIARIZATION_NUM_SPEAKERS=0         # 0 = auto-estimate
HF_TOKEN=""                        # ⚠️ REQUERIDO para pyannote gated weights

# -----------------------------------------------------------------------------
# ALIGNMENT
# -----------------------------------------------------------------------------
ALIGNMENT_METHOD="overlap_weighted"
ALIGNMENT_MIN_OVERLAP_RATIO=0.10
ALIGNMENT_TIE_BREAK="diarization_confidence"

# -----------------------------------------------------------------------------
# QUALITY ANALYSIS (PUNTO 4)
# -----------------------------------------------------------------------------
QUALITY_ENABLED=true
QUALITY_STRICT_MODE=true           # Si status=failed -> no guardar (a menos --force-save)
QUALITY_MIN_SCORE_TO_SAVE=0.30
QUALITY_PENALTY_LOW_CONF_WORD=0.005
QUALITY_PENALTY_LOW_CONF_SEGMENT=0.04

# -----------------------------------------------------------------------------
# VALIDATION
# -----------------------------------------------------------------------------
VALIDATION_ENABLED=true
VALIDATION_STRICT=true
VALIDATION_ALLOW_WHITESPACE_ONLY_TEXT=false

# -----------------------------------------------------------------------------
# METRICS (PUNTO 7)
# -----------------------------------------------------------------------------
METRICS_ENABLED=true
METRICS_TRACK_STEP_TIMINGS=true
METRICS_TRACK_MEMORY_PEAK=true
METRICS_TRACK_GPU_UTIL=true
METRICS_POLL_INTERVAL_MS=250

# -----------------------------------------------------------------------------
# STORAGE / OUTPUT
# -----------------------------------------------------------------------------
OUTPUT_JSON_INDENT=2
OUTPUT_JSON_ENSURE_ASCII=false     # Unicode español OK
OUTPUT_FILES="analysis,transcript,speakers,segments,metadata"
OUTPUT_INCLUDE_SCHEMA_VERSION=true

# -----------------------------------------------------------------------------
# PIPELINE FAIL-SAFE
# -----------------------------------------------------------------------------
PIPELINE_MAX_DURATION_SEC=28800    # 8h timeout absoluto
PIPELINE_ABORT_ON_QUALITY_FAILED=true
PIPELINE_ABORT_ON_ASR_FAILED=true
PIPELINE_SKIP_DIARIZATION_ON_ERROR=false

# -----------------------------------------------------------------------------
# LOGGING
# -----------------------------------------------------------------------------
LOG_DIR="data/output/logs"
LOG_ROTATION="100 MB"
LOG_RETENTION="30 days"
LOG_INCLUDE_PROCESS_ID=true
LOG_INCLUDE_JOB_ID=true

# -----------------------------------------------------------------------------
# TESTING / DEVELOPMENT
# -----------------------------------------------------------------------------
DEV_FIX_RANDOM_SEED=42
DEV_KEEP_TEMP_FILES=false          # true = debug, no borrar temp dir
DEV_MOCK_ASR_ENABLED=false
DEV_MOCK_DIARIZATION_ENABLED=false
DEV_MOCK_LANG_DETECT_CODE="es"
